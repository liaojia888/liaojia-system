    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "serwist": "^9.5.13",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
